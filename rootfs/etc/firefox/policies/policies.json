{
  "__comment": "PotatOS: Firefox reopens its last session on every start (browser.startup.page=3). After a hard stop (platform sleep, docker stop) Firefox normally shows a 'restore session?' page; max_resumed_crashes=-1 makes it restore right away. Privacy: no telemetry, studies, Pocket, sponsored tiles/stories or search suggestions, no captive-portal and connectivity pings (a container has no captive portal). Safe Browsing stays on. Users can still change the preferences in about:preferences (Status: default).",
  "policies": {
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "DisableAppUpdate": true,
    "Preferences": {
      "browser.startup.page": {
        "Value": 3,
        "Status": "default"
      },
      "browser.sessionstore.resume_from_crash": {
        "Value": true,
        "Status": "default"
      },
      "browser.sessionstore.max_resumed_crashes": {
        "Value": -1,
        "Status": "default"
      },
      "browser.shell.checkDefaultBrowser": {
        "Value": false,
        "Status": "default"
      },
      "network.connectivity-service.enabled": {
        "Value": false,
        "Status": "default"
      },
      "browser.newtabpage.activity-stream.feeds.telemetry": {
        "Value": false,
        "Status": "default"
      },
      "browser.newtabpage.activity-stream.telemetry": {
        "Value": false,
        "Status": "default"
      }
    },
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "CaptivePortal": false,
    "SearchSuggestEnabled": false,
    "FirefoxHome": {
      "SponsoredTopSites": false,
      "Pocket": false,
      "SponsoredPocket": false,
      "Locked": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "ImproveSuggest": false,
      "Locked": false
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "MoreFromMozilla": false,
      "SkipOnboarding": true,
      "Locked": false
    }
  }
}
