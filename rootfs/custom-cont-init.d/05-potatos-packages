#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# PotatOS: optional extra packages installed at boot (apk on the Alpine image,
# apt on the Debian/GPU image; see /usr/share/potatos/lib.sh).
#
#   POTATOS_EXTRA_PACKAGES="firefox gimp"   (space or comma separated)
#
# Packages live in the container layer, not in /config, so they are
# re-installed on every fresh container start. A failure here never blocks
# the desktop from starting.

# shellcheck source=rootfs/usr/share/potatos/lib.sh
. /usr/share/potatos/lib.sh

PKGS=""
# Package names only (lib.sh pkg_name_ok): an option such as --allow-untrusted
# or a file / URL is dropped, not passed to the package manager as root.
read -r -a WANT <<< "${POTATOS_EXTRA_PACKAGES//,/ }"     # (no glob expansion)
for p in "${WANT[@]}"; do
  if pkg_name_ok "${p}"; then PKGS="${PKGS:+${PKGS} }${p}"
  else echo "[potatos] WARNING: POTATOS_EXTRA_PACKAGES: '${p}' is not a package name, skipped"; fi
done
if [ -z "${PKGS}" ]; then
  exit 0
fi

echo "[potatos] Installing extra packages (${POTATOS_PKG}): ${PKGS}"
# shellcheck disable=SC2086
if pkg_install ${PKGS}; then
  echo "[potatos] Extra packages installed"
else
  echo "[potatos] WARNING: could not install some of: ${PKGS} (continuing anyway)"
fi
exit 0
