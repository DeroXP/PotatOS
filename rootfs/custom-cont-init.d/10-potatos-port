#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# PotatOS: HTTP port + health endpoint.
#
# Boot order in the base image (s6-rc):
#   init-nginx (writes the nginx config from CUSTOM_PORT etc.: on Alpine
#   /etc/nginx/http.d/default.conf, on Debian /etc/nginx/sites-available/default;
#   same contents, lib.sh finds it)
#     -> ... -> init-custom-files (runs THIS directory) -> svc-nginx (starts nginx)
# So by the time we run, the config exists but nginx is not running yet:
# editing the file here is enough, no reload needed.
#
# 1. PaaS hosts such as Railway tell the app which port to listen on via
#    $PORT. If PORT is set and CUSTOM_PORT is not, move the HTTP listener there.
# 2. Add an unauthenticated `GET /healthz` so health checks keep working when
#    a PASSWORD (basic auth) is enabled.

# shellcheck source=rootfs/usr/share/potatos/lib.sh
. /usr/share/potatos/lib.sh

if [ -z "${NGINX_CONFIG}" ]; then
  echo "[potatos] WARNING: nginx config not found, skipping port setup"
  exit 0
fi

# Port the base image already configured (CUSTOM_PORT or 3000).
CURRENT_PORT="${CUSTOM_PORT:-3000}"

if [ -n "${PORT}" ] && [ -z "${CUSTOM_PORT}" ]; then
  if ! [[ "${PORT}" =~ ^[0-9]+$ ]] || [ "${PORT}" -lt 1 ] || [ "${PORT}" -gt 65535 ]; then
    echo "[potatos] WARNING: ignoring invalid PORT='${PORT}'"
  elif [ "${PORT}" = "${CUSTOM_HTTPS_PORT:-3001}" ] || [ "${PORT}" = "${CUSTOM_WS_PORT:-8082}" ]; then
    echo "[potatos] WARNING: PORT=${PORT} clashes with an internal port; set CUSTOM_PORT instead"
  elif [ "${PORT}" != "${CURRENT_PORT}" ]; then
    # Only touch the plain-HTTP `listen` lines (the HTTPS ones say `ssl`).
    sed -i -E "s/listen (\[::\]:)?${CURRENT_PORT} default_server;/listen \1${PORT} default_server;/" "${NGINX_CONFIG}"
    CURRENT_PORT="${PORT}"
    echo "[potatos] PORT is set: nginx will listen on ${PORT} (HTTP)"
  fi
  # PaaS mode: the platform terminates TLS. Keep the self-signed HTTPS
  # listener off the public interfaces, so the platform sees exactly one port
  # (Railway would otherwise offer 3001 as a domain target, and plain HTTP
  # sent to a TLS port answers every request with 400).
  HTTPS_PORT="${CUSTOM_HTTPS_PORT:-3001}"
  sed -i -E -e "/listen \[::\]:${HTTPS_PORT} ssl;/d" \
            -e "s/listen ${HTTPS_PORT} ssl;/listen 127.0.0.1:${HTTPS_PORT} ssl;/" "${NGINX_CONFIG}"
  echo "[potatos] PORT is set: HTTPS :${HTTPS_PORT} only on 127.0.0.1 (TLS is terminated by the platform)"
fi

# Some hosts/kernels have no IPv6 at all; nginx then refuses to start because
# of the `listen [::]:...` lines. Drop them automatically (same as the base
# image's DISABLE_IPV6=true).
if [ ! -s /proc/net/if_inet6 ] && grep -q 'listen \[::\]' "${NGINX_CONFIG}"; then
  sed -i '/listen \[::\]/d' "${NGINX_CONFIG}"
  echo "[potatos] No IPv6 on this host: nginx will listen on IPv4 only"
fi

# Record the effective port for tools inside the container (`potatos info`).
printf '%s' "${CURRENT_PORT}" > /run/s6/container_environment/POTATOS_HTTP_PORT

# Unauthenticated health endpoint in every server block (idempotent: the base
# image regenerates the config on each boot, but guard anyway).
if ! grep -q 'location = /healthz' "${NGINX_CONFIG}"; then
  sed -i 's#^server {$#server {\n  location = /healthz { auth_basic off; access_log off; default_type text/plain; return 200 "ok"; }#' "${NGINX_CONFIG}"
fi

# Waking page. While the streaming server is still starting (container boot,
# Railway Serverless wake-up), nginx answers 502 on /api/*, and the dashboard's
# static files would load into a grey screen. So: `auth_request` makes every
# page load check /api/health first (a 2 ms loopback subrequest), and any
# 5xx becomes the branded auto-refreshing /potatos-waking.html. The paused
# page (see potatos.js) and the waking page need no login, so a parked tab
# can come back without a credentials prompt.
# (No '#' in the lines below: init-nginx strips all of them when PASSWORD is set.)
SF="${SUBFOLDER:-/}"
WEB=/usr/share/selkies/web
if ! grep -q 'potatos-waking' "${NGINX_CONFIG}"; then
  sed -i -E \
    -e "s#^  error_page 500 502 503 504 /50x.html;#  error_page 500 502 503 504 ${SF}potatos-waking.html;#" \
    -e "s#^  location ${SF} \{\$#  location ${SF} {\n    auth_request ${SF}potatos-up;#" \
    -e "s#^server \{\$#server {\n  location = ${SF}potatos-up { internal; proxy_pass http://127.0.0.1:${CUSTOM_WS_PORT:-8082}${SF}api/health; proxy_connect_timeout 2s; proxy_read_timeout 2s; }\n  location = ${SF}potatos-waking.html { auth_basic off; auth_request off; alias ${WEB}/potatos-waking.html; }\n  location = ${SF}potatos-paused.html { auth_basic off; auth_request off; alias ${WEB}/potatos-paused.html; }#" \
    "${NGINX_CONFIG}"
fi
