<?xml version="1.1" encoding="UTF-8"?>
<!-- PotatOS first-boot desktop settings (copied to /config only when the user
     has no XFCE config yet). Monitor names differ between Selkies versions /
     modes, so the wallpaper is set for each name we have seen. image-style 5 = zoomed. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="last-settings-migration-version" type="uint" value="1"/>
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorscreen" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/potatos/wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitorselkies-primary" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/potatos/wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitorselkies-display2" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/potatos/wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
