# PotatOS GPU host: copy to .env next to docker-compose.gpu.yml and fill in.
#   cp .env.gpu.example .env
#   docker compose -f docker-compose.gpu.yml up -d --build

# Public host name that points at your home IP (A/AAAA record or DDNS name).
# Caddy requests a Let's Encrypt certificate for it; port 443 must reach this PC.
POTATOS_DOMAIN=desktop.example.com

# Login (user: abc). Leave empty to have one generated and printed in
# `docker compose -f docker-compose.gpu.yml logs potatos-gpu`.
PASSWORD=

# Your local time zone (idle quiet hours, clock in the desktop).
TZ=Etc/UTC

# ultra = 120 fps at the browser window size (2560x1440 on a 1440p monitor).
POTATOS_PROFILE=ultra

# Default browser: chromium | firefox | chrome | brave (chrome/brave after
# `potatos install-browser chrome|brave` inside the desktop).
POTATOS_BROWSER=chromium

# Dynamic DNS (only if you uncomment a ddns service in docker-compose.gpu.yml)
# DUCKDNS_SUBDOMAIN=mydesktop
# DUCKDNS_TOKEN=
# CLOUDFLARE_API_TOKEN=
